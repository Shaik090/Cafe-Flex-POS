{
  "name": "cafe-flex-pos",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node tests/expenses.cjs && node tests/reports-workflow.cjs && node tests/costing.cjs && node tests/backup.cjs",
    "test:costing": "node tests/costing.cjs",
    "test:backup": "node tests/backup.cjs",
    "test:reports": "node tests/reports-workflow.cjs",
    "test:reports-screen": "jest tests/ReportsScreen.test.tsx --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-tcp-socket": "^6.4.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.ts"
    ]
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  }
}
